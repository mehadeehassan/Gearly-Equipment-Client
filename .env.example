NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Create an API key at https://api.imgbb.com/ (used by browser image uploads)
NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
DB_NAME=equipment_rental
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match the Express server values exactly
JWT_SECRET=replace-with-the-same-secret-used-by-server
JWT_ISSUER=gearly-client
JWT_AUDIENCE=gearly-api